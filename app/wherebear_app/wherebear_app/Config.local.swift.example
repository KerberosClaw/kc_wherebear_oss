// Config.local.swift.example — 範本（committed）。
// fresh checkout：copy 成 Config.local.swift 再填值 —— `cp Config.local.swift.example Config.local.swift`
// 本尊 Config.local.swift 是 gitignored（不進 repo）：prod 端點與 anon key 都住這裡。
//   anon key＝Supabase Dashboard → Settings → API → anon public（或 `supabase projects api-keys` 取 id=anon）。
//   prod URL＝`https://<你的專案 ref>.supabase.co`。專案 ref 嚴格說不是秘密（它是 API 子網域、
//   也編在 app 二進位檔裡，擋人的是 RLS 與認證），但沒理由把它白送進公開 repo。
//   synchronized group 會自動編譯 Config.local.swift。詳 docs/DEPLOYMENT.md §4。
import Foundation

enum Secrets {
    static let prodAnonKey = "<你的 prod anon public key>"
    // prod 端點＝你的 Supabase 專案
    static let prodURL = "https://<你的專案 ref>.supabase.co"
    // dev 端點＝你 mac 的 Bonjour 名（`<你的機器名>.local:54321`）；跟機器走、mDNS 被擋就改成 LAN IP（如 `http://192.168.x.x:54321`）。
    static let devURL = "http://your-mac.local:54321"
}
