# kc_wherebear — 環境變數範本（複製成 .env、填真實值；.env 不入 git）
# 真實值住這裡 / Supabase function secrets / app 的 Config.local.swift —— 永不進 repo。
# 命名：本機=dev、真實=prod。

# ── bridge daemon（拉 read-plane 端點 → 原子寫本地 JSON 給下游）──
# 讀取走 (c)：read-only Edge Function + wb_ API key（x-wb-key header）。
# service_role 永不放這、只在 Supabase function secrets。

# 讀口 base：
#   dev（本機 functions serve / LAN 手機）：http://192.168.x.x:54321/functions/v1
#   prod：https://<project-ref>.supabase.co/functions/v1
WHEREBEAR_API_BASE=http://192.168.x.x:54321/functions/v1

# 在 app（設定 → API 金鑰）發的 wb_ 金鑰（明文只顯示一次）
WHEREBEAR_API_KEY=wb_xxxxxxxxxxxxxxxx

# gateway apikey：dev（本機無 gateway）留空；prod 填該專案 anon key
WHEREBEAR_GATEWAY_APIKEY=

# 本地輸出檔（下游只讀這個；*.local.json / bridge/out/ 已 gitignore）
WHEREBEAR_OUTPUT_PATH=./bridge/out/wherebear_location.json

# 輪詢間隔（秒）
WHEREBEAR_POLL_SECONDS=300

# ── event bridge（常駐聽到達／離開事件 → 寫每日 jsonl → 叫下游）──
# 跟上面同一份 .env、同一把 wb_ 金鑰；差別只在它不輪詢、掛長連線。

# 事件檔目錄（每日一檔 events_YYYYMMDD.jsonl；bridge/out/ 已 gitignore）
WHEREBEAR_EVENT_DIR=./bridge/out/events

# 收到事件後要叫的下游處理程式絕對路徑。留空＝只寫檔不叫人（先接管線時好用）。
# 🔴 呼叫時清空環境（clearEnv），金鑰不過繼給下游。
WHEREBEAR_EVENT_JUDGE=

# 同地點同類型事件在幾秒內只算一次（CLVisit 會抖、一天也可能進出同一處多次）
WHEREBEAR_EVENT_COALESCE_S=120

# 下游處理程式單次執行逾時（秒）
WHEREBEAR_EVENT_JUDGE_TIMEOUT_S=300

# 健康告警要跑的可執行檔（收 <emoji> <text> 兩參數）。空＝不送、只寫 log。
WHEREBEAR_NOTIFY_CMD=

# 呼叫下游時要放行哪些環境變數（逗號分隔的前綴；空＝只給 PATH/HOME/LANG）。
# 那些變數叫什麼是下游的事，平台不寫死。🔴 WHEREBEAR_*/SUPABASE_* 永不放行，設了也沒用。
WHEREBEAR_EVENT_JUDGE_ENV_PREFIXES=

# ── Supabase function secrets（用 `supabase secrets set` 設，不是放這個檔）──
#   WHEREBEAR_TZ                today-stays 使用者時區（預設 Asia/Taipei）
#   WB_JWT_SECRET               realtime-token 簽短效 token 用＝專案 JWT secret（🔴 必設，沒設該端點回 500）
#   WB_REALTIME_TOKEN_TTL_S     短效 token 存活秒數（預設 1800）
#   （SUPABASE_SERVICE_ROLE_KEY 由 edge runtime 自動注入；reverse-geocode 用 Nominatim、免 key）

# ── app（實際走 app/**/Config.local.swift，不是這個檔）──
#   SUPABASE_URL       dev: http://192.168.x.x:54321 / prod: https://<ref>.supabase.co
#   SUPABASE_ANON_KEY
